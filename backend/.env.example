# backend/.env.example
# Database Connection (Neon PostgreSQL)
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-something-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-something.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Authentication & Security
JWT_SECRET="replace-with-a-very-secure-random-secret-key-at-least-32-chars"
PORT=4000
CORS_ORIGIN="http://localhost:3000"

# Python ML Microservice
ML_SERVICE_URL="http://127.0.0.1:8000"
ML_INTERNAL_KEY="replace-with-secure-internal-microservice-shared-secret"

# Supabase Storage (Backend service-role only, never expose to client)
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"
SUPABASE_BUCKET="kyc-documents"

# File Upload Constraints
MAX_UPLOAD_MB=10
